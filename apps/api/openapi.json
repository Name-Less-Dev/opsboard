      "get": {
        "description": "Filtros diferentes se combinam com AND; valores de um mesmo filtro, com OR. Empates na ordenação são desfeitos pelo id.",
        "operationId": "WorkOrdersController_findPage",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Um ou mais (OR), separados por vírgula ou repetindo o parâmetro",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/WorkOrderStatus"
              }
            }
          },
          {
            "name": "priority",
            "required": false,
            "in": "query",
            "description": "Um ou mais (OR), separados por vírgula ou repetindo o parâmetro",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/WorkOrderPriority"
              }
            }
          },
          {
            "name": "assigneeId",
            "required": false,
            "in": "query",
            "description": "UUID de um usuário ou `me` (o usuário autenticado)",
            "schema": {
              "example": "me",
              "type": "string"
            }
          },
          {
            "name": "overdue",
            "required": false,
            "in": "query",
            "description": "`true` filtra só atrasadas; `false` ou ausente não filtra",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "dueFrom",
            "required": false,
            "in": "query",
            "description": "Prazo a partir deste instante (inclusivo); exige hora e fuso",
            "schema": {
              "format": "date-time",
              "example": "2026-11-01T00:00:00-03:00",
              "type": "string"
            }
          },
          {
            "name": "dueTo",
            "required": false,
            "in": "query",
            "description": "Prazo até este instante (inclusivo); não pode ser anterior a `dueFrom`",
            "schema": {
              "format": "date-time",
              "example": "2026-11-30T23:59:59-03:00",
              "type": "string"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Trecho do título ou da descrição, sem diferenciar maiúsculas",
            "schema": {
              "maxLength": 100,
              "example": "filtro",
              "type": "string"
            }
          },
          {
            "name": "sortBy",
            "required": false,
            "in": "query",
            "schema": {
              "default": "createdAt",
              "type": "string",
              "enum": [
                "createdAt",
                "updatedAt",
                "dueDate",
                "priority"
              ]
            }
          },
          {
            "name": "order",
            "required": false,
            "in": "query",
            "schema": {
              "default": "desc",
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkOrderPageResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR: payload, query ou parâmetro inválido (ver `details`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR: erro inesperado; o detalhe fica no log com o requestId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Lista as ordens com filtros, busca, ordenação e paginação",
        "tags": [
          "work-orders"
        ]
      }
    },

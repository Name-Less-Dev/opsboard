    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "up"
            ]
          }
        },
        "required": [
          "status",
          "database"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "UNAUTHORIZED",
          "FORBIDDEN",
          "NOT_FOUND",
          "INVALID_TRANSITION",
          "ORDER_FINALIZED",
          "CONCURRENT_UPDATE",
          "CONFLICT",
          "TOO_MANY_REQUESTS",
          "INTERNAL_ERROR",
          "SERVICE_UNAVAILABLE",
          "HTTP_ERROR"
        ],
        "description": "Estável: é o que o cliente deve usar para decidir o que fazer"
      },
      "ValidationDetailDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "title",
            "description": "Campo inválido; aninhados com ponto (items.0.name)"
          },
          "messages": {
            "example": [
              "title must be longer than or equal to 3 characters"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "field",
          "messages"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "code": {
            "example": "VALIDATION_ERROR",
            "description": "Estável: é o que o cliente deve usar para decidir o que fazer",
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "message": {
            "type": "string",
            "example": "Dados inválidos",
            "description": "Legível, em português; pode mudar"
          },
          "details": {
            "description": "Só em VALIDATION_ERROR, e sempre presente nele (pode ser vazio)",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationDetailDto"
            }
          },
          "path": {
            "type": "string",
            "example": "/work-orders",
            "description": "Caminho, sem a query string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-04T12:00:00.000Z"
          },
          "requestId": {
            "type": "string",
            "example": "0b6d2a4e-3f1c-4d9a-8e7b-5c2f1a0d9e8b",
            "description": "Igual ao header x-request-id; informe ao suporte em caso de erro 500"
          }
        },
        "required": [
          "statusCode",
          "code",
          "message",
          "path",
          "timestamp",
          "requestId"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "supervisor@opsboard.dev"
          },
          "password": {
            "type": "string",
            "example": "opsboard123",
            "maxLength": 72
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "OPERATOR",
          "SUPERVISOR"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Carla Supervisora"
          },
          "email": {
            "type": "string",
            "example": "supervisor@opsboard.dev"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "WorkOrderPriority": {
        "type": "string",
        "enum": [
          "LOW",
          "MEDIUM",
          "HIGH",
          "URGENT"
        ]
      },
      "CreateWorkOrderDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120,
            "example": "Trocar filtro do ar-condicionado"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "nullable": true
          },
          "priority": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WorkOrderPriority"
              }
            ]
          },
          "dueDate": {
            "type": "string",
            "example": "2026-12-01T18:00:00-03:00",
            "format": "date-time",
            "description": "Data e hora com fuso; não pode estar no passado"
          },
          "assigneeId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Operador: omita, envie null ou o próprio id. Supervisor: qualquer usuário ou null."
          }
        },
        "required": [
          "title",
          "priority",
          "dueDate"
        ]
      },
      "WorkOrderStatus": {
        "type": "string",
        "enum": [
          "OPEN",
          "IN_PROGRESS",
          "DONE",
          "CANCELLED"
        ]
      },
      "UserRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "9cbbf785-9a72-4703-b484-0afd39d65703"
          },
          "name": {
            "type": "string",
            "example": "Ana Operadora"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "WorkOrderResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "3f6c1d2e-8a4b-4c7d-9e0f-1a2b3c4d5e6f"
          },
          "title": {
            "type": "string",
            "example": "Vazamento na pia da copa"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "Água acumulando embaixo do gabinete."
          },
          "priority": {
            "example": "HIGH",
            "allOf": [
              {
                "$ref": "#/components/schemas/WorkOrderPriority"
              }
            ]
          },
          "status": {
            "example": "IN_PROGRESS",
            "allOf": [
              {
                "$ref": "#/components/schemas/WorkOrderStatus"
              }
            ]
          },
          "dueDate": {
            "format": "date-time",
            "type": "string",
            "example": "2026-11-01T17:00:00.000Z"
          },
          "assignee": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserRefDto"
              }
            ]
          },
          "createdBy": {
            "$ref": "#/components/schemas/UserRefDto"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-10-19T14:30:00.000Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-10-20T09:15:00.000Z"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "priority",
          "status",
          "dueDate",
          "assignee",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]
      },
      "WorkOrderPageResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkOrderResponseDto"
            }
          },
          "total": {
            "type": "number",
            "example": 42
          },
          "page": {
            "type": "number",
            "example": 1
          },
          "pageSize": {
            "type": "number",
            "example": 20
          },
          "totalPages": {
            "type": "number",
            "example": 3,
            "description": "Arredondado para cima; 0 quando não há resultados"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "pageSize",
          "totalPages"
        ]
      },
      "UpdateWorkOrderDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "nullable": true,
            "description": "null limpa a descrição"
          },
          "priority": {
            "description": "Somente supervisor",
            "allOf": [
              {
                "$ref": "#/components/schemas/WorkOrderPriority"
              }
            ]
          },
          "dueDate": {
            "type": "string",
            "example": "2026-12-01T18:00:00-03:00",
            "format": "date-time",
            "description": "Somente supervisor; data e hora com fuso"
          }
        }
      },
      "UpdateStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WorkOrderStatus"
              }
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "UpdateAssigneeDto": {
        "type": "object",
        "properties": {
          "assigneeId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "null remove o responsável"
          }
        },
        "required": [
          "assigneeId"
        ]
      },
      "StatusCountsDto": {
        "type": "object",
        "properties": {
          "OPEN": {
            "type": "number",
            "example": 5
          },
          "IN_PROGRESS": {
            "type": "number",
            "example": 2
          },
          "DONE": {
            "type": "number",
            "example": 2
          },
          "CANCELLED": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "OPEN",
          "IN_PROGRESS",
          "DONE",
          "CANCELLED"
        ]
      },
      "OverdueDto": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number",
            "example": 4,
            "description": "Total de ordens atrasadas"
          },
          "items": {
            "description": "Até 10 atrasadas, prazo mais antigo primeiro",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkOrderResponseDto"
            }
          }
        },
        "required": [
          "count",
          "items"
        ]
      },
      "DashboardSummaryDto": {
        "type": "object",
        "properties": {
          "byStatus": {
            "description": "Sempre com as 4 chaves; 0 quando vazio",
            "allOf": [
              {
                "$ref": "#/components/schemas/StatusCountsDto"
              }
            ]
          },
          "overdue": {
            "$ref": "#/components/schemas/OverdueDto"
          },
          "generatedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-11-03T16:40:09.764Z",
            "description": "Instante usado como \"agora\" no cálculo de atrasadas"
          }
        },
        "required": [
          "byStatus",
          "overdue",
          "generatedAt"
        ]
      }
    }
  }
}

{
  "rootDir": ".",
  "projects": ["<rootDir>/package.json", "<rootDir>/test/jest-e2e.json"],
  "coverageDirectory": "<rootDir>/coverage",
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/generated/**",
    "!src/**/*.dto.ts",
    "!src/**/dto/**",
    "!src/**/*.module.ts",
    "!src/main.ts",
    "!src/scripts/**"
  ],
  "coverageThreshold": {
    "global": {
      "statements": 80,
      "branches": 70,
      "functions": 80,
      "lines": 80
    },
    "./src/work-orders/work-order.policy.ts": {
      "statements": 90,
      "branches": 90,
      "functions": 90,
      "lines": 90
    },
    "./src/work-orders/work-order-query.ts": {
      "statements": 90,
      "branches": 90,
      "functions": 90,
      "lines": 90
    },
    "./src/common/errors/error-mapper.ts": {
      "statements": 90,
      "branches": 90,
      "functions": 90,
      "lines": 90
    }
  }
}

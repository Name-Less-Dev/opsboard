{
  "name": "opsboard",
  "private": true,
  "version": "0.1.0",
  "description": "Painel de ordens de serviço full-stack (React + NestJS + PostgreSQL)",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @opsboard/api\" \"npm run dev -w @opsboard/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "db:migrate": "npm run db:migrate -w @opsboard/api",
    "db:seed": "npm run db:seed -w @opsboard/api",
    "db:deploy": "npm run db:deploy -w @opsboard/api",
    "format": "prettier --write .",
    "seed:large": "npm run seed:large -w @opsboard/api",
    "seed:demo": "npm run seed:demo -w @opsboard/api",
    "e2e:db": "npm run e2e:db -w @opsboard/api",
    "contract:generate": "npm run openapi:export -w @opsboard/api && npm run types:generate -w @opsboard/web",
    "check:contract": "npm run contract:generate && git diff --exit-code -- apps/api/openapi.json apps/web/src/lib/api-types.ts",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "e2e": "node scripts/e2e-ensure-db.mjs && npm run e2e -w @opsboard/web",
    "e2e:ui": "node scripts/e2e-ensure-db.mjs && npm run e2e:ui -w @opsboard/web",
    "e2e:screenshots": "node scripts/e2e-ensure-db.mjs && npm run e2e:screenshots -w @opsboard/web",
    "typecheck": "tsc -p apps/api --noEmit && tsc -b apps/web",
    "test:api": "npm run test:cov -w @opsboard/api",
    "test:web": "npm run test:cov -w @opsboard/web",
    "ci": "npm run prisma:generate && npm run lint && npm run typecheck && npm run test:api && npm run test:web && npm run check:contract",
    "prisma:generate": "npm run db:generate -w @opsboard/api",
    "e2e:install": "npm run e2e:install -w @opsboard/web",
    "docker:ci:env": "node scripts/ci-docker-env.mjs",
    "docker:ci:up": "docker compose -p opsboard-ci --env-file .env.ci up -d --build --wait",
    "docker:ci:smoke": "node scripts/docker-smoke.mjs",
    "docker:ci:logs": "docker compose -p opsboard-ci --env-file .env.ci logs",
    "docker:ci:down": "docker compose -p opsboard-ci --env-file .env.ci down -v",
    "smoke": "node scripts/smoke.mjs",
    "video:demo": "node scripts/video-demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "^9.2.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1"
  },
  "license": "MIT"
}

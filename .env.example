# Copie para .env e ajuste. O docker compose lê o .env da raiz automaticamente;
# sem ele, o compose não sobe, porque JWT_SECRET não tem valor padrão.

# Postgres (serviço db)
POSTGRES_USER=opsboard
POSTGRES_PASSWORD=opsboard
POSTGRES_DB=opsboard

# Usada pela API e pelo Prisma quando rodam fora do Docker (npm run dev, migrations, seed).
# Dentro do compose, a api usa o host "db" (definido no docker-compose.yml).
DATABASE_URL=postgresql://opsboard:opsboard@localhost:5432/opsboard

# JWT. Mínimo de 32 caracteres. O valor abaixo só serve para npm run dev: a API recusa este valor
# com NODE_ENV=production, que é o caso do docker compose. Gere um com: openssl rand -base64 32
JWT_SECRET=dev-only-troque-este-segredo-de-exemplo-local
JWT_EXPIRES_IN=1h

# Origens liberadas no CORS, separadas por vírgula. Vazio = nenhuma (o front usa a mesma origem).
CORS_ORIGINS=
# Proxies confiáveis à frente da API (para o IP real no limite de login). 0 = ignora X-Forwarded-For.
# Valor maior que o número real de proxies deixa o cliente forjar o IP e escapar do limite.
TRUST_PROXY=0
# Tentativas de login por IP na janela (segundos).
LOGIN_RATE_LIMIT=5
LOGIN_RATE_TTL=60
# Swagger em /docs. Padrão: ligado fora de produção, desligado em produção.
# SWAGGER_ENABLED=true

# CSV. Fuso IANA do prazo só com data (fim do dia) e do horário no nome do arquivo exportado.
APP_TIMEZONE=America/Sao_Paulo
# Máximo de linhas por exportação (acima disso, 422 EXPORT_TOO_LARGE) e de ordens por importação.
EXPORT_MAX_ROWS=10000
IMPORT_MAX_ROWS=500

# Banco dos testes de integração (precisa terminar em _test; é criado sozinho).
TEST_DATABASE_URL=postgresql://opsboard:opsboard@localhost:5432/opsboard_test

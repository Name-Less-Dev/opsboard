{
  "rootDir": ".",
  "projects": ["<rootDir>/package.json", "<rootDir>/test/jest-e2e.json"],
  "coverageDirectory": "<rootDir>/coverage",
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/generated/**",
    "!src/**/*.dto.ts",
    "!src/**/dto/**",
    "!src/**/*.module.ts",
    "!src/main.ts",
    "!src/scripts/**"
  ],
  "coverageThreshold": {
    "global": {
      "statements": 95,
      "branches": 85,
      "functions": 95,
      "lines": 95
    },
    "./src/work-orders/work-order.policy.ts": {
      "statements": 100,
      "branches": 100,
      "functions": 100,
      "lines": 100
    },
    "./src/work-orders/work-order-query.ts": {
      "statements": 100,
      "branches": 100,
      "functions": 100,
      "lines": 100
    },
    "./src/common/errors/error-mapper.ts": {
      "statements": 100,
      "branches": 100,
      "functions": 100,
      "lines": 100
    },
    "./src/common/errors/validation-details.ts": {
      "statements": 100,
      "branches": 100,
      "functions": 100,
      "lines": 100
    },
    "./src/config/app-config.ts": {
      "statements": 100,
      "branches": 100,
      "functions": 100,
      "lines": 100
    }
  }
}

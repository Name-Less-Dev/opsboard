# Copie para .env e ajuste. O docker compose lê o .env da raiz automaticamente;
# sem ele, o compose não sobe, porque JWT_SECRET não tem valor padrão.

# Postgres (serviço db)
POSTGRES_USER=opsboard
POSTGRES_PASSWORD=opsboard
POSTGRES_DB=opsboard

# Usada pela API e pelo Prisma quando rodam fora do Docker (npm run dev, migrations, seed).
# Dentro do compose, a api usa o host "db" (definido no docker-compose.yml).
DATABASE_URL=postgresql://opsboard:opsboard@localhost:5432/opsboard

# JWT. Troque o segredo fora do ambiente local (ex.: openssl rand -base64 32).
JWT_SECRET=dev-only-troque-este-segredo
JWT_EXPIRES_IN=1h
